<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The macOS app intentionally runs UN-sandboxed. An EDR cannot operate
  inside the app sandbox: it needs to read /Library/LaunchAgents,
  /Library/LaunchDaemons, /Library/SystemExtensions, the loginwindow
  preference plists, and spawn /usr/bin/sfltool — all of which the
  sandbox blocks. The privileged data sources (BTM database, kernel
  call interfaces) still require their own per-source elevation;
  removing the sandbox is necessary but not sufficient.

  Distribution-grade restricted entitlements (Endpoint Security at
  M8, Network Extension at M7, etc.) require the paid Apple Developer
  Program; tracking submissions at
  docs/apple-developer/entitlement-requests.md.
-->
<plist version="1.0">
<dict>
</dict>
</plist>
