# Swift Package Manager
.build/
.swiftpm/
# Package.resolved IS committed: nightwatch ships an executable (nwctl) plus
# downstream consumers (apps, future extensions), so dependency versions
# need to be pinned for reproducible builds. See SwiftPM docs on
# "Package.resolved File" / "Library vs. tool packages".

# Signing and secrets
*.p12
*.cer
*.mobileprovision
*.provisionprofile
.env
.env.*

# macOS
.DS_Store

# Build artifacts
*.dmg
*.pkg
*.xcarchive
*.ipa
*.app
*.appex
*.systemextension

# Logs and reports
*.log
coverage/
*.profdata
*.profraw

